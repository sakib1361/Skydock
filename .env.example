# Copy to .env (which git ignores) and fill in.
#
# These are packed into every binary you build, so the people you give a
# build to just sign in through their browser and never see a client ID.
# Skydock also reads .env from the directory it is started in, which lets
# you try different values without rebuilding.

# Microsoft Entra application (client) ID.
SKYDOCK_ONEDRIVE_CLIENT_ID=

# Google Cloud OAuth client of type "Desktop app".
SKYDOCK_GDRIVE_CLIENT_ID=
SKYDOCK_GDRIVE_CLIENT_SECRET=

# Sign-in tokens are never stored here; they live in the desktop keyring.
